# Environment
.env
.env.local
.env.production

# Dependencies
node_modules/
.venv/
venv/

# Build artifacts
dist/
build/
.next/
out/
*.egg-info/

# ...but these patterns are unanchored, so a directory named build/, dist/ or
# out/ anywhere gets swallowed. The /build pipeline skill is a real tracked
# surface, not a build output — re-include it.
!.claude/skills/build/
!.claude/skills/build/**

# Python caches
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Test output
.coverage
htmlcov/
playwright-report/
test-results/
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Generated / large files Claude should skip
*.min.js
*.min.css
*.map

# Lockfiles ARE tracked, deliberately. They were ignored here alongside
# generated assets, which made every install unpinned: `npm ci` fails outright
# without package-lock.json, so E15-S2-AC1's "clean checkout -> docker compose
# up -> all three report healthy" could never pass, and `uv sync` silently
# re-resolved the backend. A lockfile is the reproducibility record, not a
# build artifact.

# Harness state — .claude/state/ is a tracked snapshot: ratchet baselines
# (agent-readiness/coupling/coverage/cycle), learned-rules.md, process-rules.md,
# failures.md, iteration-log.md stay committed. Only runtime churn is ignored
# below — caches, indexes, logs, counters, and *.jsonl ledgers. All scoped to
# .claude/state/ so real project data (e.g. a data/*.jsonl fixture) is never hit.
.claude/runs/
# Per-instance review checkouts created by /gate. These are full nested git
# repositories: a `git add -A` swept seven of them into a commit as embedded
# repos, which clones cannot resolve.
.claude/worktrees/
.claude/state/archive/
.claude/state/context-cache/
.claude/state/tool-output/
.claude/state/nav-index/
.claude/state/*.jsonl
.claude/state/*.log
.claude/state/*.offset
.claude/state/lane-router-last.txt
.claude/state/last-drift-scan.txt
.claude/state/review-block-count
.claude/state/auto-continue-count
.claude/state/auto-continue-progress
.claude/state/inflight-agents.json
.claude/state/human-codebase.json
.claude/state/nav-graph-index.json
.claude/state/context-pack-last.json
.claude/state/nav-telemetry-summary.json
.claude/tdd-guard/
.claude/claude-security-guidance.local.md
