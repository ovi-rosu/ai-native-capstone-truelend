# TrueLend development environment.
#
# Copy to `.env` (gitignored) and adjust. Every variable takes the
# `TRUELEND_` prefix that `backend/src/config/settings.py` declares.
#
# `database_url` and `jwt_secret` have NO default in code on purpose: a
# committed default DSN carries credentials, and a default signing key is how
# a development secret reaches production. An empty value fails fast at
# startup instead.

# Postgres, matching the docker-compose service E15-S2 defines.
TRUELEND_DATABASE_URL=postgresql+psycopg://truelend:truelend@localhost:5432/truelend

# Generate a real one per environment, e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(48))"`. Do not reuse this placeholder.
TRUELEND_JWT_SECRET=replace-me-with-a-generated-secret

# Session lifetime is fixed at 60 minutes by decision D-M; override only if
# that decision changes.
TRUELEND_JWT_TTL_SECONDS=3600

TRUELEND_LOG_LEVEL=INFO
TRUELEND_SERVICE_NAME=truelend-backend
