{
  "name": "ai-native-capstone-truelend",
  "description": "Horizon Bank wants a configurable loan-origination platform that lets the business launch new loan products without code changes. You build the application-to-disbursement-to-repayment lifecycle, with policy-driven underwriting rules — under one constraint: no manual coding. Every line of production code must be generated by Claude Code agents under your supervision.",
  "stack": {
    "backend": {
      "language": "python",
      "version": "3.12",
      "framework": "fastapi",
      "package_manager": "uv",
      "linter": "ruff",
      "typechecker": "mypy",
      "test_runner": "pytest"
    },
    "frontend": {
      "language": "typescript",
      "version": "5.x",
      "framework": "react-vite",
      "package_manager": "npm",
      "linter": "eslint",
      "typechecker": "tsc",
      "test_runner": "vitest"
    },
    "database": {
      "primary": "postgresql",
      "secondary": null
    }
  },
  "architecture": {
    "layers": [
      "types",
      "config",
      "repository",
      "service",
      "api",
      "ui"
    ],
    "layer_roots": [
      "backend/src",
      "frontend/src"
    ],
    "contexts": {
      "roots": [
        "backend/src/repository/policy",
        "backend/src/repository/origination",
        "backend/src/repository/servicing",
        "backend/src/repository/delinquency",
        "backend/src/repository/identity",
        "backend/src/service/policy",
        "backend/src/service/origination",
        "backend/src/service/servicing",
        "backend/src/service/delinquency",
        "backend/src/service/identity"
      ],
      "public": [
        "__init__"
      ]
    }
  },
  "lsp": {
    "servers": [
      {
        "language": "python",
        "server": "pyright",
        "binary": "pyright",
        "install": "npm i -g pyright"
      },
      {
        "language": "typescript",
        "server": "typescript-language-server",
        "binary": "typescript-language-server",
        "install": "npm i -g typescript-language-server typescript"
      }
    ]
  },
  "evaluation": {
    "api_base_url": "http://localhost:8000",
    "ui_base_url": "http://localhost:3000",
    "health_check": "/health",
    "design_score_threshold": 7,
    "design_max_iterations": 3,
    "test_corpus_dir": "specs/test_artefacts"
  },
  "execution": {
    "default_mode": "full",
    "model_tier": "balanced",
    "ceremony": "trimmed",
    "session_chaining": true,
    "teammate_model": "sonnet",
    "// budget": "unset — /auto uses the model_tier default cap (cost tier ~= 80 agents / $8 / 30 min). To enforce a per-build ceiling, replace this key with  budget: { est_cost_usd, agents, wall_clock_ms }  — or pass --budget at run time. See docs/token-cost-playbook.md."
  },
  "verification": {
    "e2e_targets": [],
    "mode": "local",
    "docker": {
      "compose_file": "docker-compose.yml",
      "services": [
        "backend",
        "frontend"
      ]
    },
    "mode_note": "local until E15-S2 (group B) creates docker-compose.yml; flip back to docker once it exists and Docker Desktop is installed, since E15-S2-AC1 asserts docker compose up."
  },
  "topology": "web-app",
  "quality": {
    "sensor_tier": "standard",
    "test_discipline": "outcomes",
    "agent_readiness": {
      "mode": "report",
      "min_active_pillars": 3,
      "forbid_regression": false
    },
    "sast_engine": "semgrep",
    "mutation": {
      "tool": "mutmut",
      "config_file": "pyproject.toml",
      "critical_globs": []
    }
  },
  "token_governor": {
    "enabled": true,
    "mode": "enforced",
    "living_navigation": true,
    "context_search_required": true,
    "max_source_read_lines": 300,
    "tool_output_token_estimates": true,
    "compress_tool_output": true,
    "ccr_enabled": true,
    "preserve_full_outputs": true,
    "budget_warn_pct": 80
  },
  "observability": {
    "enabled": true,
    "metrics_path": "/metrics",
    "red_labels": [
      "method",
      "route",
      "status"
    ],
    "slo": {
      "error_rate_pct": 1,
      "p95_ms": 500
    }
  },
  "framework_skill_packs": [
    "fastapi-code"
  ],
  "custom_sensors": [],
  "github": {
    "org": "",
    "default_branch": "main",
    "required_checks": [
      "gitleaks",
      "sast"
    ],
    "required_approvals": 1,
    "require_code_owner_review": true,
    "enforce_admins": true,
    "ruleset_scope": "org",
    "ruleset_name": "harness-baseline-protection",
    "target_repos": "~ALL",
    "default_owners": [],
    "environments": [
      {
        "name": "production",
        "reviewers": [],
        "wait_timer": 0,
        "protected_branches": true
      }
    ]
  },
  "harness_version": "3.0.0"
}
