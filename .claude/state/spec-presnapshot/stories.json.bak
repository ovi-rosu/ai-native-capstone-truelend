  {
    "id": "E3-S1",
    "title": "Append-only policy version store and destructive migration lint",
    "epic": "E3",
    "layer": "Repository",
    "story_points": 5,
    "estimation_confidence": "high",
    "estimation_drivers": {
      "functional_scope": 1,
      "technical_complexity": 2,
      "data_state_impact": 2,
      "integration_surface": 2,
      "uncertainty_risk": 1,
      "total": 8,
      "evidence": "Repository plus schema plus two static scanners; the immutability line is fixed by D5."
    },
    "readiness": "ready",
    "breakdown_reason": null,
    "user_story": "As an auditor, I want approved policy versions and every migration to be append-only so that the rules a past decision was made under can always be reconstructed.",
    "business_value": "Guarantees a decision's basis is reconstructible years later, which is what lets the policy editor ship without an audit objection.",
    "description": "Implements the D5 immutable side of the line: a policy_version repository with no update or delete method, an architecture test that counts UPDATE, DELETE and ORM mutations against that table across src/ and migrations/, and a migration lint that rejects destructive statements. Mutable loan state stays out of scope by design.",
    "scope_in": [
      "policy_version table and append-only repository",
      "Architecture test counting mutations against policy_version",
      "Migration lint over every file in migrations/, including policy migrations"
    ],
    "scope_out": [
      "must not expose an update or delete method on the policy_version repository",
      "must not restrict application.status, loan.outstanding_principal or loan.delinquency_bucket, which stay mutable per D5",
      "must not add a destructive statement to any migration to simplify a schema change"
    ],
    "safeguards": [
      "SG-8"
    ],
    "depends_on": [
      {
        "story": "E9-S1",
        "kind": "contract",
        "artifact": "Money value type",
        "reason": "threshold columns are monetary and typed by the published Money artifact"
      },
      {
        "story": "E1-S1",
        "kind": "behavior",
        "reason": "the tracer already writes and activates a policy version that this store must hold immutably"
      }
    ],
    "traces": [
      "FRD-19",
      "FRD-22"
    ],
    "invest": {
      "independent": true,
      "negotiable": true,
      "valuable": true,
      "estimable": true,
      "small": true,
      "testable": true
    },
    "acceptance_criteria": [
      {
        "id": "E3-S1-AC1",
        "given": "the policy_version repository interface",
        "when": "its public methods are enumerated",
        "then": "no update method and no delete method is exposed",
        "traces": [
          "FRD-19"
        ]
      },
      {
        "id": "E3-S1-AC2",
        "given": "the contents of src/ and migrations/",
        "when": "the immutability architecture test scans them",
        "then": "it reports 0 UPDATE statements, 0 DELETE statements and 0 ORM mutations targeting policy_version",
        "traces": [
          "FRD-19"
        ]
      },
      {
        "id": "E3-S1-AC3",
        "given": "every file under migrations/",
        "when": "the migration lint parses them",
        "then": "it reports 0 DROP TABLE, 0 DROP COLUMN and 0 destructive ALTER statements",
        "traces": [
          "FRD-22"
        ]
      },
      {
        "id": "E3-S1-AC4",
        "given": "a policy migration file",
        "when": "it is parsed by that same lint",
        "then": "it is held to the identical zero-destructive-statement assertion as a schema migration",
        "traces": [
          "FRD-22"
        ]
      }
    ],
    "group": "C",
    "cluster": "C1"
  },
