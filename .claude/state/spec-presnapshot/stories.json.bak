    },
    "readiness": "ready",
    "breakdown_reason": null,
    "user_story": "As a platform operator, I want every request to emit structured, correlated, PII-free logs and a health probe so that I can diagnose the origination flow without leaking applicant identifiers.",
    "business_value": "Removes the retrofit pass that would otherwise have to revisit every handler written before observability existed, and keeps synthetic PAN, Aadhaar and salary content out of operational logs.",
    "description": "Installs the platform logging substrate before any other epic emits a log line: JSON formatter, correlation-id middleware that honours or generates X-Request-ID, a redaction filter on every configured logger, and the /health endpoint. D12 places this first in M1 because NFR-03 and NFR-06 are retrofit-hostile.",
    "scope_in": [
      "JSON log formatter, correlation-id middleware and redaction filter registered in the app factory",
      "GET /health returning a JSON readiness body",
      "Log-capture test harness reused by later stories"
    ],
    "scope_out": [
      "must not add any business endpoint beyond /health",
      "must not write applicant PAN, Aadhaar or salary-document content to any log sink",
      "must not introduce an external log-shipping provider or credentials"
    ],
    "safeguards": [
      "SG-9"
    ],
    "depends_on": [],
    "traces": [
      "FRD-20",
      "FRD-23",
      "FRD-24"
    ],
    "invest": {
      "independent": true,
      "negotiable": true,
      "valuable": true,
      "estimable": true,
      "small": true,
      "testable": true
    },
    "acceptance_criteria": [
      {
